# SmartPOS local environment template — copy to .env.local and fill in real
# values. The .env.local file is gitignored so secrets never reach the repo.

# ── Active AI provider ──────────────────────────────────────────────────────
# One of: stub | openai | anthropic | deepseek
AI_PROVIDER=stub

# ── DeepSeek (OpenAI-compatible API) ────────────────────────────────────────
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── OpenAI ─────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic ──────────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
