<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  @page { size: A4; margin: 15mm; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 12px; color: #1a1a1a; line-height: 1.7; }
  .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; border-bottom: 3px solid #1e293b; padding-bottom: 16px; }
  .logo { font-size: 24px; font-weight: 700; color: #1e293b; }
  .company-info { text-align: right; font-size: 11px; color: #555; line-height: 1.5; }
  .doc-title { font-size: 22px; font-weight: 700; color: #1e293b; margin-bottom: 4px; text-align: center; margin-top: 20px; }
  .doc-subtitle { text-align: center; font-size: 13px; color: #555; margin-bottom: 30px; }
  .doc-meta { display: flex; justify-content: space-between; margin-bottom: 24px; }
  .meta-box { flex: 1; }
  .meta-label { font-size: 10px; text-transform: uppercase; color: #888; letter-spacing: 1px; margin-bottom: 2px; }
  .meta-value { font-size: 13px; font-weight: 500; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
  thead th { background: #f8fafc; padding: 10px 12px; text-align: left; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: #475569; border-bottom: 2px solid #cbd5e1; }
  tbody td { padding: 10px 12px; border-bottom: 1px solid #e2e8f0; font-size: 12px; }
  .text-right { text-align: right; }
  .footer { margin-top: 40px; border-top: 1px solid #e2e8f0; padding-top: 16px; font-size: 10px; color: #888; line-height: 1.6; }
  .signature { display: flex; justify-content: space-between; margin-top: 50px; }
  .sig-block { text-align: center; }
  .sig-line { border-bottom: 1px solid #1a1a1a; width: 200px; margin-bottom: 6px; }
  .sig-label { font-size: 11px; color: #555; }
  .section-title { font-size: 13px; font-weight: 700; color: #0f172a; margin-bottom: 10px; margin-top: 24px; text-transform: uppercase; border-bottom: 1px solid #e2e8f0; padding-bottom: 6px; }
  .party-box { background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 6px; padding: 14px 18px; margin-bottom: 14px; }
  .party-box .party-name { font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 4px; }
  .party-box .party-detail { font-size: 11px; color: #475569; line-height: 1.6; }
  .clause { margin-bottom: 14px; padding-left: 10px; border-left: 3px solid #e2e8f0; }
  .clause p { font-size: 12px; color: #334155; line-height: 1.8; }
  .witness-block { display: flex; justify-content: space-between; margin-top: 50px; }
</style>
</head>
<body>

<div class="header">
  <div>
    <div class="logo">{{company.name}}</div>
    <div style="font-size:11px;color:#555;">{{company.address}}</div>
    <div style="font-size:11px;color:#555;">TIN: {{company.tin}}</div>
  </div>
  <div class="company-info">
    <div>{{company.phone}}</div>
    <div>{{company.email}}</div>
    <div>{{company.website}}</div>
  </div>
</div>

<div class="doc-title">SERVICE AGREEMENT</div>
<div class="doc-subtitle">Contract Reference: {{document.number}} | Date: {{document.date}}</div>

<div class="section-title">1. Parties</div>

<div class="party-box">
  <div class="party-name">Service Provider</div>
  <div class="party-detail">
    <strong>{{company.name}}</strong><br>
    {{company.address}}<br>
    TIN: {{company.tin}}<br>
    Phone: {{company.phone}} | Email: {{company.email}}
  </div>
</div>

<div class="party-box">
  <div class="party-name">Client</div>
  <div class="party-detail">
    <strong>{{customer.name}}</strong><br>
    {{customer.address}}<br>
    {{#if customer.tin}}TIN: {{customer.tin}}<br>{{/if}}
    Phone: {{customer.phone}} | Email: {{customer.email}}
  </div>
</div>

<div class="section-title">2. Contract Period</div>
<div class="clause">
  <p>This Agreement shall commence on <strong>{{document.startDate}}</strong> and shall continue until <strong>{{document.endDate}}</strong> unless terminated earlier in accordance with the provisions herein.</p>
</div>

<div class="section-title">3. Service Description</div>
<div class="clause">
  <p>{{document.serviceDescription}}</p>
</div>

<div class="section-title">4. Pricing</div>
<div class="clause">
  <p>{{document.pricingTerms}}</p>
</div>

<table>
  <thead>
    <tr>
      <th>Service Item</th>
      <th>Frequency</th>
      <th style="width:120px;" class="text-right">Rate</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr>
      <td><strong>{{name}}</strong>{{#if description}}<br><span style="font-size:10px;color:#888;">{{description}}</span>{{/if}}</td>
      <td>{{frequency}}</td>
      <td class="text-right">{{rate}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<div class="section-title">5. Payment Terms</div>
<div class="clause">
  <p>{{document.paymentTerms}}</p>
</div>

<div class="section-title">6. Termination</div>
<div class="clause">
  <p>{{document.terminationClause}}</p>
</div>

<div class="section-title">7. Governing Law</div>
<div class="clause">
  <p>{{document.governingLaw}}</p>
</div>

<div class="signature">
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label" style="font-weight:700;">{{company.name}}<br>Service Provider</div>
  </div>
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label" style="font-weight:700;">{{customer.name}}<br>Client</div>
  </div>
</div>

<div class="witness-block" style="margin-top:30px;">
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Witness (Provider)</div>
  </div>
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Witness (Client)</div>
  </div>
</div>

<div class="footer">
  <div>{{company.name}} | {{company.address}} | TIN: {{company.tin}}</div>
  <div>Phone: {{company.phone}} | Email: {{company.email}}</div>
  <div>Page 1 of 1 | Generated on {{document.date}}</div>
</div>

</body>
</html>
