<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  @page { size: A4; margin: 15mm; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 12px; color: #1a1a1a; }
  .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; border-bottom: 3px solid #16A34A; padding-bottom: 16px; }
  .logo { font-size: 24px; font-weight: 700; color: #16A34A; }
  .company-info { text-align: right; font-size: 11px; color: #555; line-height: 1.5; }
  .doc-title { font-size: 22px; font-weight: 700; color: #16A34A; margin-bottom: 4px; }
  .doc-meta { display: flex; justify-content: space-between; margin-bottom: 24px; }
  .meta-box { flex: 1; }
  .meta-label { font-size: 10px; text-transform: uppercase; color: #888; letter-spacing: 1px; margin-bottom: 2px; }
  .meta-value { font-size: 13px; font-weight: 500; }
  .footer { margin-top: 40px; border-top: 1px solid #e2e8f0; padding-top: 16px; font-size: 10px; color: #888; line-height: 1.6; }
  .text-right { text-align: right; }
  .payment-summary { background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 20px; margin-bottom: 24px; }
  .payment-summary h3 { font-size: 14px; color: #15803d; margin-bottom: 12px; }
  .payment-details { display: flex; flex-wrap: wrap; gap: 16px; }
  .payment-field { flex: 1; min-width: 180px; }
  .payment-field .label { font-size: 10px; text-transform: uppercase; color: #888; letter-spacing: 1px; margin-bottom: 2px; }
  .payment-field .value { font-size: 13px; font-weight: 500; }
  .amount-paid { font-size: 28px; font-weight: 700; color: #15803d; text-align: center; padding: 16px 0; border-bottom: 2px solid #bbf7d0; margin-bottom: 16px; }
  .ref-invoice { margin-top: 16px; font-size: 11px; color: #555; }
  .stamp-area { margin-top: 60px; text-align: right; }
  .stamp-box { display: inline-block; border: 1px dashed #888; border-radius: 4px; padding: 20px 40px; text-align: center; }
  .stamp-box .stamp-label { font-size: 10px; color: #888; text-transform: uppercase; letter-spacing: 1px; }
  .balance-section { background: #fefce8; border: 1px solid #fde68a; border-radius: 6px; padding: 14px; margin-top: 16px; }
  .balance-section .label { font-size: 10px; text-transform: uppercase; color: #a16207; letter-spacing: 1px; margin-bottom: 2px; }
  .balance-section .value { font-size: 14px; font-weight: 600; color: #854d0e; }
</style>
</head>
<body>

<div class="header">
  <div>
    {{#if company.showLogo}}
      {{#if company.logoUrl}}
        <img src="{{company.logoUrl}}" style="max-height:{{company.logoSize}}px; object-fit:contain;" />
      {{else}}
        <div class="logo">{{company.name}}</div>
      {{/if}}
    {{else}}
      <div class="logo">{{company.name}}</div>
    {{/if}}
    {{#if company.address}}<div style="font-size:11px;color:#555;">{{company.address}}</div>{{/if}}
    {{#if company.tin}}<div style="font-size:11px;color:#555;">TIN: {{company.tin}}</div>{{/if}}
    {{#if company.vatRegNo}}
    <div style="font-size:11px;color:#555;">VAT Reg: {{company.vatRegNo}}</div>
    {{/if}}
  </div>
  <div class="company-info">
    {{#if company.phone}}<div>{{company.phone}}</div>{{/if}}
    {{#if company.email}}<div>{{company.email}}</div>{{/if}}
    {{#if company.website}}<div>{{company.website}}</div>{{/if}}
  </div>
</div>

<div class="doc-title">PAYMENT RECEIPT</div>

<div class="doc-meta">
  <div class="meta-box">
    <div class="meta-label">Receipt #</div>
    <div class="meta-value">{{document.number}}</div>
  </div>
  <div class="meta-box">
    <div class="meta-label">Date</div>
    <div class="meta-value">{{document.date}}</div>
  </div>
  <div class="meta-box">
    <div class="meta-label">Payment Method</div>
    <div class="meta-value">{{payment.method}}</div>
  </div>
</div>

<div class="doc-meta">
  <div class="meta-box">
    <div class="meta-label">Received From</div>
    <div class="meta-value">{{customer.name}}</div>
    <div style="font-size:11px;color:#555;">{{customer.address}}</div>
    <div style="font-size:11px;color:#555;">{{customer.phone}}</div>
  </div>
  <div class="meta-box">
    <div class="meta-label">Received By</div>
    <div class="meta-value">{{receivedBy.name}}</div>
  </div>
</div>

<div class="payment-summary">
  <h3>Payment Summary</h3>
  <div class="amount-paid">{{payment.amount}}</div>
  <div class="payment-details">
    <div class="payment-field">
      <div class="label">Payment Method</div>
      <div class="value">{{payment.method}}</div>
    </div>
    {{#if payment.reference}}
    <div class="payment-field">
      <div class="label">Reference / Cheque #</div>
      <div class="value">{{payment.reference}}</div>
    </div>
    {{/if}}
    {{#if payment.transactionId}}
    <div class="payment-field">
      <div class="label">Transaction ID</div>
      <div class="value">{{payment.transactionId}}</div>
    </div>
    {{/if}}
  </div>
  <div class="ref-invoice">
    <strong>Reference Invoice:</strong> {{referenceInvoice.number}} dated {{referenceInvoice.date}}
    {{#if referenceInvoice.amount}}<br><strong>Invoice Amount:</strong> {{referenceInvoice.amount}}{{/if}}
  </div>
</div>

<div class="balance-section">
  <div class="label">Balance Due After This Payment</div>
  <div class="value">{{balance.due}}</div>
</div>

{{#if payment.notes}}
<div style="margin-top: 24px; font-size: 11px; color: #555;">
  <strong>Notes:</strong> {{payment.notes}}
</div>
{{/if}}

<div class="stamp-area">
  <div class="stamp-box">
    <div class="stamp-label">Official Stamp</div>
    <div style="font-size:10px;color:#aaa;margin-top:4px;">{{company.name}}</div>
  </div>
</div>

<div class="footer">
  <div>{{company.name}} | {{company.address}} | TIN: {{company.tin}}</div>
  <div>Phone: {{company.phone}} | Email: {{company.email}}</div>
  <div>Page 1 of 1 | Generated on {{document.date}}</div>
</div>

</body>
</html>
