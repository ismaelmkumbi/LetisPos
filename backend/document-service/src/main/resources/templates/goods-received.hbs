<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  @page { size: A4; margin: 15mm; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 12px; color: #1a1a1a; }
  .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; border-bottom: 3px solid #0891b2; padding-bottom: 16px; }
  .logo { font-size: 24px; font-weight: 700; color: #0891b2; }
  .company-info { text-align: right; font-size: 11px; color: #555; line-height: 1.5; }
  .doc-title { font-size: 22px; font-weight: 700; color: #0891b2; margin-bottom: 4px; }
  .doc-meta { display: flex; justify-content: space-between; margin-bottom: 24px; }
  .meta-box { flex: 1; }
  .meta-label { font-size: 10px; text-transform: uppercase; color: #888; letter-spacing: 1px; margin-bottom: 2px; }
  .meta-value { font-size: 13px; font-weight: 500; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
  thead th { background: #ecfeff; padding: 10px 12px; text-align: left; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: #0e7490; border-bottom: 2px solid #a5f3fc; }
  tbody td { padding: 10px 12px; border-bottom: 1px solid #e2e8f0; font-size: 12px; }
  .text-right { text-align: right; }
  .footer { margin-top: 40px; border-top: 1px solid #e2e8f0; padding-top: 16px; font-size: 10px; color: #888; line-height: 1.6; }
  .terms { margin-top: 20px; }
  .terms h4 { font-size: 11px; margin-bottom: 6px; }
  .terms p { font-size: 10px; color: #666; }
  .signature { display: flex; justify-content: space-between; margin-top: 50px; }
  .sig-block { text-align: center; }
  .sig-line { border-bottom: 1px solid #1a1a1a; width: 200px; margin-bottom: 6px; }
  .sig-label { font-size: 11px; color: #555; }
  .info-box { background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 6px; padding: 10px 14px; font-size: 11px; color: #0369a1; margin-top: 16px; }
  .quality-check { background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: 16px; margin-top: 24px; }
  .quality-check h4 { font-size: 11px; color: #92400e; margin-bottom: 12px; }
  .checklist { display: flex; flex-wrap: wrap; gap: 12px; }
  .check-item { display: flex; align-items: center; gap: 8px; font-size: 11px; color: #555; }
  .check-box { width: 18px; height: 18px; border: 2px solid #d4d4d4; border-radius: 3px; display: inline-block; }
  .check-box.checked { background: #0891b2; border-color: #0891b2; }
  .status-good { color: #15803d; }
  .status-damaged { color: #dc2626; }
  .status-short { color: #d97706; }
</style>
</head>
<body>

<div class="header">
  <div>
    {{#if company.showLogo}}
      {{#if company.logoUrl}}
        <img src="{{company.logoUrl}}" style="max-height:{{company.logoSize}}px; object-fit:contain;" />
      {{else}}
        <div class="logo">{{company.name}}</div>
      {{/if}}
    {{else}}
      <div class="logo">{{company.name}}</div>
    {{/if}}
    {{#if company.address}}<div style="font-size:11px;color:#555;">{{company.address}}</div>{{/if}}
    {{#if company.tin}}<div style="font-size:11px;color:#555;">TIN: {{company.tin}}</div>{{/if}}
    {{#if company.vatRegNo}}
    <div style="font-size:11px;color:#555;">VAT Reg: {{company.vatRegNo}}</div>
    {{/if}}
  </div>
  <div class="company-info">
    {{#if company.phone}}<div>{{company.phone}}</div>{{/if}}
    {{#if company.email}}<div>{{company.email}}</div>{{/if}}
    {{#if company.website}}<div>{{company.website}}</div>{{/if}}
  </div>
</div>

<div class="doc-title">GOODS RECEIVED NOTE</div>

<div class="doc-meta">
  <div class="meta-box">
    <div class="meta-label">GRN #</div>
    <div class="meta-value">{{document.number}}</div>
  </div>
  <div class="meta-box">
    <div class="meta-label">Date Received</div>
    <div class="meta-value">{{document.date}}</div>
  </div>
  <div class="meta-box">
    <div class="meta-label">Reference</div>
    <div class="meta-value">{{document.reference}}</div>
  </div>
</div>

<div class="doc-meta">
  <div class="meta-box">
    <div class="meta-label">Supplier</div>
    <div class="meta-value">{{supplier.name}}</div>
    <div style="font-size:11px;color:#555;">{{supplier.address}}</div>
    <div style="font-size:11px;color:#555;">{{supplier.phone}}</div>
  </div>
  <div class="meta-box">
    <div class="meta-label">Received By</div>
    <div class="meta-value">{{receivedBy.name}}</div>
  </div>
</div>

<table>
  <thead>
    <tr>
      <th style="width:40px;">#</th>
      <th>Item / Description</th>
      <th style="width:70px;" class="text-right">Ordered</th>
      <th style="width:70px;" class="text-right">Received</th>
      <th style="width:70px;" class="text-right">Variance</th>
      <th style="width:90px;" class="text-right">Status</th>
    </tr>
  </thead>
  <tbody>
    {{#each items}}
    <tr>
      <td>{{inc @index}}</td>
      <td><strong>{{name}}</strong>{{#if description}}<br><span style="font-size:10px;color:#888;">{{description}}</span>{{/if}}</td>
      <td class="text-right">{{orderedQty}}</td>
      <td class="text-right">{{receivedQty}}</td>
      <td class="text-right">{{#if variance}}{{variance}}{{else}}0{{/if}}</td>
      <td class="text-right">
        {{#if (eq status "good")}}
        <span class="status-good">OK</span>
        {{else if (eq status "damaged")}}
        <span class="status-damaged">Damaged</span>
        {{else if (eq status "short")}}
        <span class="status-short">Short</span>
        {{else}}
        <span>{{status}}</span>
        {{/if}}
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

<div class="quality-check">
  <h4>Quality Check</h4>
  <div class="checklist">
    <div class="check-item">
      <span class="check-box"></span>
      <span>Packaging Intact</span>
    </div>
    <div class="check-item">
      <span class="check-box"></span>
      <span>Quantity Correct</span>
    </div>
    <div class="check-item">
      <span class="check-box"></span>
      <span>No Visible Damage</span>
    </div>
    <div class="check-item">
      <span class="check-box"></span>
      <span>Labels Match</span>
    </div>
    <div class="check-item">
      <span class="check-box"></span>
      <span>Expiry Date Acceptable</span>
    </div>
    <div class="check-item">
      <span class="check-box"></span>
      <span>Temperature OK (if applicable)</span>
    </div>
  </div>
</div>

{{#if notes}}
<div style="margin-top: 20px; font-size: 11px; color: #555;">
  <strong>Inspection Notes:</strong> {{notes}}
</div>
{{/if}}

<div class="signature">
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Received By</div>
  </div>
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Verified By</div>
  </div>
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Date</div>
  </div>
</div>

<div class="footer">
  <div>{{company.name}} | {{company.address}} | TIN: {{company.tin}}</div>
  <div>Phone: {{company.phone}} | Email: {{company.email}}</div>
  <div>Page 1 of 1 | Generated on {{document.date}}</div>
</div>

</body>
</html>
