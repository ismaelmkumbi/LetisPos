<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  @page { size: A4; margin: 15mm; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 12px; color: #1a1a1a; }
  .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; border-bottom: 3px solid #0d9488; padding-bottom: 16px; }
  .logo { font-size: 24px; font-weight: 700; color: #0d9488; }
  .company-info { text-align: right; font-size: 11px; color: #555; line-height: 1.5; }
  .doc-title { font-size: 22px; font-weight: 700; color: #0d9488; margin-bottom: 4px; }
  .doc-meta { display: flex; justify-content: space-between; margin-bottom: 24px; }
  .meta-box { flex: 1; }
  .meta-label { font-size: 10px; text-transform: uppercase; color: #888; letter-spacing: 1px; margin-bottom: 2px; }
  .meta-value { font-size: 13px; font-weight: 500; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
  thead th { background: #f0fdfa; padding: 10px 12px; text-align: left; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: #0f766e; border-bottom: 2px solid #99f6e4; }
  tbody td { padding: 10px 12px; border-bottom: 1px solid #e2e8f0; font-size: 12px; }
  .text-right { text-align: right; }
  .footer { margin-top: 40px; border-top: 1px solid #e2e8f0; padding-top: 16px; font-size: 10px; color: #888; line-height: 1.6; }
  .statement-summary { display: flex; gap: 16px; margin-bottom: 24px; }
  .summary-card { flex: 1; background: #f0fdfa; border: 1px solid #99f6e4; border-radius: 8px; padding: 14px; }
  .summary-card.negative { background: #fef2f2; border-color: #fecaca; }
  .summary-card .summary-label { font-size: 10px; text-transform: uppercase; color: #0f766e; letter-spacing: 1px; margin-bottom: 4px; }
  .summary-card.negative .summary-label { color: #991b1b; }
  .summary-card .summary-value { font-size: 18px; font-weight: 700; color: #0f766e; }
  .summary-card.negative .summary-value { color: #dc2626; }
  .aging-section { margin-top: 24px; }
  .aging-section h4 { font-size: 12px; margin-bottom: 12px; color: #333; }
  .aging-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
  .aging-table th { background: #f1f5f9; padding: 10px 12px; text-align: left; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: #555; border-bottom: 2px solid #e2e8f0; }
  .aging-table td { padding: 10px 12px; font-size: 12px; border-bottom: 1px solid #e2e8f0; }
  .aging-total td { font-weight: 700; background: #f8fafc; }
  .disclaimer-box { background: #ECFDF5; border: 1px solid #BBF7D0; border-radius: 6px; padding: 10px 14px; font-size: 10px; color: #15803D; margin-top: 24px; }
  .period-info { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 12px 16px; margin-bottom: 24px; }
  .period-info .period-label { font-size: 10px; text-transform: uppercase; color: #888; letter-spacing: 1px; }
  .period-info .period-value { font-size: 13px; font-weight: 500; }
</style>
</head>
<body>

<div class="header">
  <div>
    <div class="logo">{{company.name}}</div>
    <div style="font-size:11px;color:#555;">{{company.address}}</div>
    <div style="font-size:11px;color:#555;">TIN: {{company.tin}}</div>
  </div>
  <div class="company-info">
    <div>{{company.phone}}</div>
    <div>{{company.email}}</div>
    <div>{{company.website}}</div>
  </div>
</div>

<div class="doc-title">CUSTOMER STATEMENT</div>

<div class="doc-meta">
  <div class="meta-box">
    <div class="meta-label">Statement #</div>
    <div class="meta-value">{{document.number}}</div>
  </div>
  <div class="meta-box">
    <div class="meta-label">Date</div>
    <div class="meta-value">{{document.date}}</div>
  </div>
  <div class="meta-box">
    <div class="meta-label">Period</div>
    <div class="meta-value">{{statement.period}}</div>
  </div>
</div>

<div class="doc-meta">
  <div class="meta-box">
    <div class="meta-label">Customer</div>
    <div class="meta-value">{{customer.name}}</div>
    <div style="font-size:11px;color:#555;">{{customer.address}}</div>
    <div style="font-size:11px;color:#555;">{{customer.phone}}</div>
    {{#if customer.tin}}
    <div style="font-size:11px;color:#555;">TIN: {{customer.tin}}</div>
    {{/if}}
  </div>
  <div class="meta-box">
    <div class="meta-label">Prepared By</div>
    <div class="meta-value">{{preparedBy.name}}</div>
  </div>
</div>

<div class="statement-summary">
  <div class="summary-card">
    <div class="summary-label">Opening Balance</div>
    <div class="summary-value">{{statement.openingBalance}}</div>
  </div>
  <div class="summary-card">
    <div class="summary-label">Total Debits</div>
    <div class="summary-value">{{statement.totalDebits}}</div>
  </div>
  <div class="summary-card">
    <div class="summary-label">Total Credits</div>
    <div class="summary-value">{{statement.totalCredits}}</div>
  </div>
  <div class="summary-card {{#if (gt statement.closingBalance 0)}}negative{{/if}}">
    <div class="summary-label">Closing Balance</div>
    <div class="summary-value">{{statement.closingBalance}}</div>
  </div>
</div>

<table>
  <thead>
    <tr>
      <th style="width:85px;">Date</th>
      <th>Reference</th>
      <th style="width:200px;">Description</th>
      <th style="width:100px;" class="text-right">Debit</th>
      <th style="width:100px;" class="text-right">Credit</th>
      <th style="width:120px;" class="text-right">Balance</th>
    </tr>
  </thead>
  <tbody>
    <tr style="background:#f8fafc;">
      <td>{{statement.periodStart}}</td>
      <td colspan="2"><em>Opening Balance</em></td>
      <td class="text-right"></td>
      <td class="text-right"></td>
      <td class="text-right"><strong>{{statement.openingBalance}}</strong></td>
    </tr>
    {{#each transactions}}
    <tr>
      <td>{{date}}</td>
      <td>{{reference}}</td>
      <td>{{description}}</td>
      <td class="text-right">{{#if debit}}{{debit}}{{/if}}</td>
      <td class="text-right">{{#if credit}}{{credit}}{{/if}}</td>
      <td class="text-right"><strong>{{balance}}</strong></td>
    </tr>
    {{/each}}
    <tr style="background:#f0fdfa; font-weight:700;">
      <td colspan="3"><em>Closing Balance as of {{document.date}}</em></td>
      <td class="text-right"><strong>{{statement.totalDebits}}</strong></td>
      <td class="text-right"><strong>{{statement.totalCredits}}</strong></td>
      <td class="text-right"><strong>{{statement.closingBalance}}</strong></td>
    </tr>
  </tbody>
</table>

<div class="aging-section">
  <h4>Aging Summary (as of {{document.date}})</h4>
  <table class="aging-table">
    <thead>
      <tr>
        <th>Aging Period</th>
        <th class="text-right">Amount Due</th>
        <th class="text-right">% of Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each aging}}
      <tr>
        <td>{{period}}</td>
        <td class="text-right">{{amount}}</td>
        <td class="text-right">{{percentage}}%</td>
      </tr>
      {{/each}}
      <tr class="aging-total">
        <td><strong>Total Outstanding</strong></td>
        <td class="text-right"><strong>{{statement.closingBalance}}</strong></td>
        <td class="text-right"><strong>100%</strong></td>
      </tr>
    </tbody>
  </table>
</div>

{{#if notes}}
<div style="margin-top: 16px; font-size: 11px; color: #555;">
  <strong>Notes:</strong> {{notes}}
</div>
{{/if}}

<div class="disclaimer-box">
  <strong>Disclaimer:</strong> This statement is provided for information purposes only. Please review and report any discrepancies
  within 14 days. All amounts are in the local currency unless otherwise stated. Interest may accrue on overdue balances.
</div>

<div class="signature">
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Prepared By</div>
  </div>
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Authorized Signatory</div>
  </div>
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Date</div>
  </div>
</div>

<div class="footer">
  <div>{{company.name}} | {{company.address}} | TIN: {{company.tin}}</div>
  <div>Phone: {{company.phone}} | Email: {{company.email}}</div>
  <div>Page 1 of 1 | Generated on {{document.date}}</div>
</div>

</body>
</html>
