<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
  @page { size: A4; margin: 15mm; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Helvetica Neue', Arial, sans-serif; font-size: 12px; color: #e2e8f0; background: #0f172a; }
  .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; border-bottom: 3px solid #38bdf8; padding-bottom: 16px; }
  .logo { font-size: 24px; font-weight: 700; color: #38bdf8; }
  .company-info { text-align: right; font-size: 11px; color: #94a3b8; line-height: 1.5; }
  .doc-title { font-size: 22px; font-weight: 700; color: #38bdf8; margin-bottom: 4px; }
  .doc-subtitle { font-size: 13px; color: #94a3b8; margin-bottom: 20px; }
  .doc-meta { display: flex; justify-content: space-between; margin-bottom: 24px; }
  .meta-box { flex: 1; }
  .meta-label { font-size: 10px; text-transform: uppercase; color: #64748b; letter-spacing: 1px; margin-bottom: 2px; }
  .meta-value { font-size: 13px; font-weight: 500; color: #cbd5e1; }
  table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
  thead th { background: #1e293b; padding: 10px 12px; text-align: left; font-size: 10px; text-transform: uppercase; letter-spacing: 0.5px; color: #38bdf8; border-bottom: 2px solid #334155; }
  tbody td { padding: 10px 12px; border-bottom: 1px solid #1e293b; font-size: 11px; color: #cbd5e1; }
  tbody tr:nth-child(even) { background: #1a2332; }
  .text-right { text-align: right; }
  .text-center { text-align: center; }
  .footer { margin-top: 40px; border-top: 1px solid #1e293b; padding-top: 16px; font-size: 10px; color: #64748b; line-height: 1.6; }
  .signature { display: flex; justify-content: space-between; margin-top: 50px; }
  .sig-block { text-align: center; }
  .sig-line { border-bottom: 1px solid #94a3b8; width: 200px; margin-bottom: 6px; }
  .sig-label { font-size: 11px; color: #94a3b8; }
  .section-title { font-size: 13px; font-weight: 700; color: #38bdf8; margin-bottom: 10px; margin-top: 20px; text-transform: uppercase; }
  .filter-box { background: #1e293b; border: 1px solid #334155; border-radius: 6px; padding: 14px 18px; font-size: 12px; color: #cbd5e1; line-height: 1.8; margin-bottom: 16px; }
  .filter-grid { display: flex; gap: 24px; }
  .filter-item { flex: 1; }
  .filter-item .label { font-size: 9px; text-transform: uppercase; color: #64748b; letter-spacing: 0.5px; }
  .filter-item .value { font-size: 12px; color: #e2e8f0; font-weight: 500; }
  .action-create { color: #4ade80; }
  .action-update { color: #facc15; }
  .action-delete { color: #f87171; }
  .action-login { color: #60a5fa; }
  .action-export { color: #c084fc; }
  .page-info { text-align: right; font-size: 10px; color: #64748b; margin-bottom: 10px; }
  .summary-box { background: #1e293b; border: 1px solid #334155; border-radius: 6px; padding: 10px 14px; font-size: 10px; color: #94a3b8; margin-bottom: 16px; text-align: center; }
</style>
</head>
<body>

<div class="header">
  <div>
    <div class="logo">{{company.name}}</div>
    <div style="font-size:11px;color:#94a3b8;">{{company.address}}</div>
    <div style="font-size:11px;color:#94a3b8;">TIN: {{company.tin}}</div>
  </div>
  <div class="company-info">
    <div>{{company.phone}}</div>
    <div>{{company.email}}</div>
    <div>{{company.website}}</div>
  </div>
</div>

<div class="doc-title">AUDIT TRAIL REPORT</div>
<div class="doc-subtitle">Ref: {{document.number}}</div>

<div class="section-title">Report Parameters</div>
<div class="filter-box">
  <div class="filter-grid">
    <div class="filter-item">
      <div class="label">Date Range</div>
      <div class="value">{{document.startDate}} &mdash; {{document.endDate}}</div>
    </div>
    <div class="filter-item">
      <div class="label">Generated On</div>
      <div class="value">{{document.date}}</div>
    </div>
    <div class="filter-item">
      <div class="label">Generated By</div>
      <div class="value">{{document.generatedBy}}</div>
    </div>
  </div>
  {{#if document.filters}}
  <div style="margin-top:10px;">
    <div class="label">Applied Filters:</div>
    <div class="value">{{document.filters}}</div>
  </div>
  {{/if}}
</div>

<div class="summary-box">
  Total Records: <strong>{{document.totalRecords}}</strong> |
  Showing page {{document.currentPage}} of {{document.totalPages}}
</div>

<table>
  <thead>
    <tr>
      <th style="width:130px;">Timestamp</th>
      <th style="width:80px;">User</th>
      <th style="width:70px;">Action</th>
      <th style="width:80px;">Entity Type</th>
      <th style="width:100px;">Entity ID</th>
      <th>Details</th>
    </tr>
  </thead>
  <tbody>
    {{#each entries}}
    <tr>
      <td style="font-size:10px;">{{timestamp}}</td>
      <td>{{user}}</td>
      <td><span class="action-{{action}}">{{action}}</span></td>
      <td>{{entityType}}</td>
      <td style="font-size:10px;">{{entityId}}</td>
      <td style="font-size:10px;">{{details}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<div class="page-info">Page {{document.currentPage}} of {{document.totalPages}}</div>

<div class="signature">
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Prepared By</div>
  </div>
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Reviewed By</div>
  </div>
  <div class="sig-block">
    <div class="sig-line"></div>
    <div class="sig-label">Date</div>
  </div>
</div>

<div class="footer">
  <div>{{company.name}} | {{company.address}} | TIN: {{company.tin}}</div>
  <div>Phone: {{company.phone}} | Email: {{company.email}}</div>
  <div>Page {{document.currentPage}} of {{document.totalPages}} | Generated on {{document.date}}</div>
</div>

</body>
</html>
