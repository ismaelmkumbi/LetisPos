# LetisPOS — Production environment variables
# ============================================
# Copy to each server as .env and fill in the values.
# Never commit the filled-in version.

# ── Image tag ─────────────────────────────────────────────
IMAGE_TAG=latest

# ── Database root ─────────────────────────────────────────
DB_ROOT_PASSWORD=change-me-to-strong-password
PG_REPLICATION_USER=replicator
PG_REPLICATION_PASSWORD=change-me-to-replication-password

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_USER=smartpos
POSTGRES_PASSWORD=${DB_ROOT_PASSWORD}

# ── Per-service DB passwords (all services) ───────────────
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me-auth

USER_DB_USER=user_user
USER_DB_PASSWORD=change-me-user

PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=change-me-product

INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=change-me-inventory

SALES_DB_USER=sales_user
SALES_DB_PASSWORD=change-me-sales

PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=change-me-payment

REPORT_DB_USER=report_user
REPORT_DB_PASSWORD=change-me-report

NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=change-me-notification

HRM_DB_USER=hrm_user
HRM_DB_PASSWORD=change-me-hrm

AI_DB_USER=ai_user
AI_DB_PASSWORD=change-me-ai

INTEGRATION_DB_USER=integration_user
INTEGRATION_DB_PASSWORD=change-me-integration

DOCUMENT_DB_USER=document_user
DOCUMENT_DB_PASSWORD=change-me-document

COMMERCE_DB_USER=commerce_user
COMMERCE_DB_PASSWORD=change-me-commerce

AUDIT_DB_USER=audit_user
AUDIT_DB_PASSWORD=change-me-audit

BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=change-me-billing

CRM_DB_USER=crm_user
CRM_DB_PASSWORD=change-me-crm

CONTROL_HUB_DB_USER=control_hub_user
CONTROL_HUB_DB_PASSWORD=change-me-control-hub

# ── Redis ─────────────────────────────────────────────────
# (uses same as Postgres root if on same server)

# ── Kafka ─────────────────────────────────────────────────
KAFKA_CLUSTER_ID=letispos-prod-c

# ── MinIO ─────────────────────────────────────────────────
MINIO_ROOT_USER=letispos
MINIO_ROOT_PASSWORD=change-me-minio

# ── JWT ───────────────────────────────────────────────────
# Path to JWT key directory (must contain private.pem and public.pem)
JWT_KEYS_DIR=/etc/letispos/jwt

# ── Email ─────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here

# ── AI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Application ───────────────────────────────────────────
APP_BASE_URL=https://letispos.com

# ── Monitoring ────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ── Server IPs (private network for cross-server routing) ────
SERVER_A_IP=10.0.0.1
SERVER_B_IP=10.0.0.2
SERVER_C_IP=10.0.0.3
