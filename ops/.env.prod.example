# LetisPOS — Production environment variables
# ============================================
# Copy to /var/www/LetisPos/.env on the server and fill in real values.
# docker compose reads this file automatically when run from /var/www/LetisPos.
#
# NEVER commit the real .env file to git.

# ── Image tag (set by CI deploy step) ─────────────────────────────────────────
IMAGE_TAG=latest

# ── Postgres root password (for the postgres container itself) ─────────────────
DB_ROOT_PASSWORD=changeme_root_password

# ── Per-service DB credentials (must match what was created in init-databases.sql)
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=changeme_auth

USER_DB_USER=user_user
USER_DB_PASSWORD=changeme_user

PRODUCT_DB_USER=product_user
PRODUCT_DB_PASSWORD=changeme_product

INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=changeme_inventory

SALES_DB_USER=sales_user
SALES_DB_PASSWORD=changeme_sales

PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=changeme_payment

REPORT_DB_USER=report_user
REPORT_DB_PASSWORD=changeme_report

NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=changeme_notification

HRM_DB_USER=hrm_user
HRM_DB_PASSWORD=changeme_hrm

AI_DB_USER=ai_user
AI_DB_PASSWORD=changeme_ai

INTEGRATION_DB_USER=integration_user
INTEGRATION_DB_PASSWORD=changeme_integration

# ── MinIO (object storage) ─────────────────────────────────────────────────────
MINIO_ROOT_USER=smartpos
MINIO_ROOT_PASSWORD=changeme_minio

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_CLUSTER_ID=smartpos-prod-1

# ── AI service ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
