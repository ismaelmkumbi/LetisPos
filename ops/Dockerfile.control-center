# Control Center UI — LetisPOS monitoring dashboard
# =================================================
# Serves the React/MUI dashboard via nginx.

FROM nginx:1.27-alpine

COPY ops/tools/control-center-ui/dist /usr/share/nginx/html

COPY ops/production/nginx/control-center.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1
